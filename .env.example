# کپی کن به فایل .env و مقادیرش رو پر کن
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,mahditaghdisi.ir,www.mahditaghdisi.ir,.onrender.com
# روی Render این رو خودش با ساختن دیتابیس Postgres پر می‌کنه (Internal Database URL)
DATABASE_URL=sqlite:///db.sqlite3
CSRF_TRUSTED_ORIGINS=https://mahditaghdisi.ir,https://www.mahditaghdisi.ir

# ایمیل نوتیفیکیشن فرم تماس (اختیاری — اگه خالی بمونه، سایت مشکلی نداره، فقط ایمیل نمی‌ره)
# راهنما: با اکانت جیمیلت یه "App Password" بساز (نیاز به 2FA فعال داره):
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
CONTACT_NOTIFY_EMAIL=mahditaghdisi650@gmail.com
